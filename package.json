{
  "name": "px4-ros2-converter",
  "displayName": "PennAIR PX4 ROS 2 Converter",
  "description": "Visualize PX4 ROS 2 bags with attitude, local position, a flight trail, and a geographic map.",
  "publisher": "pennair",
  "homepage": "https://github.com/pennaerial/px4_converter",
  "version": "0.2.0",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": [],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "lint:fix": "eslint --fix .",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package -o dist/px4-ros2-converter-$npm_package_version.foxe",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.0",
    "@foxglove/extension": "2.39.2",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "create-foxglove-extension": "1.1.2",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@foxglove/schemas": "^1.8.0"
  }
}
